# Neon pooled connection (used by the Next.js app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Neon direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Vercel Blob token for wish photos
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Session JWT (16+ characters)
AUTH_SECRET="replace-with-a-long-random-secret"

# Bootstrap admin account on first signup/login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
